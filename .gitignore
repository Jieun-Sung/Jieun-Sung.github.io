# Editable CV source — only the exported PDF is published.
assets/cv/*.docx

# Source figures and manuscript drafts. The originals are print-resolution
# (scDEBART is ~100 megapixels) and the manuscripts are unpublished drafts,
# so neither belongs in a public repo. The web-sized figures generated from
# these live in assets/img/thumbs/ and ARE committed.
assets/thumbnails/

# Camera original for the portrait. The committed crop is assets/img/portrait_2.png.
assets/img/IMG_*.jpg

# Dropbox / OS noise
*.sync-conflict-*
* (conflicted copy *).*
.dropbox
.dropbox.attr
Thumbs.db
desktop.ini
.DS_Store
